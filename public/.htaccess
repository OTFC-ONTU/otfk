<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Каталог завантажень (/storage → storage/app/public) — лише дані: скрипти
    # там ніколи не виконуються. Рівень mod_rewrite обрано тому, що він гарантовано
    # працює на хостингу (цей же файл маршрутизує всі запити у index.php).
    RewriteRule ^storage/.*\.(?i:php|phtml|php[0-9]|phar|pl|py|cgi|sh|shtml|phps)(?:\.|$) - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Канонічна адреса основного домену (docs/seo-plan.md, етап 1): лише для
    # otfk.od.ua, тестовий хостинг і localhost ці правила не зачіпають.
    # www → без www одразу на https (один 301); шлях і query зберігаються
    # (Apache сам дописує query, якщо в підстановці немає «?»).
    RewriteCond %{HTTP_HOST} ^www\.otfk\.od\.ua(:\d+)?$ [NC]
    RewriteRule ^ https://otfk.od.ua%{REQUEST_URI} [L,R=301]

    # HTTP → HTTPS для otfk.od.ua. За nginx-фронтендом хостингу TLS може
    # завершуватися до Apache, тому https визначаємо і за %{HTTPS}, і за
    # заголовками проксі — інакше вийде нескінченний редирект.
    RewriteCond %{HTTP_HOST} ^otfk\.od\.ua(:\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteCond %{HTTP:X-Forwarded-SSL} !^on$ [NC]
    RewriteRule ^ https://otfk.od.ua%{REQUEST_URI} [L,R=301]

    # Redirect Trailing Slashes If Not A Folder...
    # Розділи старого сайту (адреси зі слешем у кінці) не обробляються тут:
    # Laravel сам нормалізує слеш у legacy_redirects і веде на нову адресу
    # одним переходом, без проміжного 301 на шлях без слешу. Список — верхні
    # каталоги старого сайту, яких немає серед маршрутів нового (video є — не тут).
    RewriteCond %{REQUEST_URI} !^/(?:news|structure|student|public_information|applicant|about_us|distance_learning|licensing_and_accreditation|conference|survey|attestation|docx|imp_message|study|feedback|corruption_alert|contacts|images|uploads)/
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Довге кешування статики: файли Vite мають хеш у назві, тому їх безпечно
# кешувати на рік (нова збірка = нова назва файлу). Діє, якщо статику віддає Apache.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
