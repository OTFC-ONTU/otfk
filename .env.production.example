# ── Production .env для Хостинг Україна ──
# Скопіюйте цей файл у .env на сервері та заповніть значення.

APP_NAME="Одеський технічний фаховий коледж ОНТУ"
APP_ENV=production
# При перенесенні наявної БД збережіть APP_KEY вихідного сервера (секрети 2FA).
# Лише для нового порожнього оточення: php artisan key:generate.
APP_KEY=
APP_DEBUG=false
APP_URL=https://ВАШ-ДОМЕН

APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_FAKER_LOCALE=uk_UA
APP_TIMEZONE=Europe/Kyiv

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── База даних (створіть у панелі хостингу та підставте значення) ──
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ВАША_БАЗА
DB_USERNAME=ВАШ_КОРИСТУВАЧ
DB_PASSWORD=ВАШ_ПАРОЛЬ

# ── Перший адміністратор (створюється при seed). Репозиторій публічний -
# обовʼязково задайте СВІЙ надійний пароль ДО запуску migrate --seed. ──
ADMIN_EMAIL=admin@ВАШ-ДОМЕН
ADMIN_PASSWORD=ЗАМІНІТЬ_НА_НАДІЙНИЙ_ПАРОЛЬ

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookie сесії лише по HTTPS (сайт працює тільки по HTTPS)
SESSION_SECURE_COOKIE=true
# Двофакторний захист адмінки (Google Authenticator) — обов'язковий для всіх.
# Аварійний вимикач, якщо всі адміністратори втратили застосунок і коди
# відновлення: TWO_FACTOR_ENFORCE=false → увійти → отфк:two-factor --reset → повернути true.
TWO_FACTOR_ENFORCE=true
# Індексація пошуковиками: auto дозволяє її лише на основному домені
# (SEO_PRIMARY_HOST); тестовий хостинг автоматично отримує noindex.
# Явне true/false — лише свідоме перевизначення для окремого оточення.
SEO_INDEXING=auto
SEO_PRIMARY_HOST=otfk.od.ua
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Пошта ──
# Форми звернень/заявок вилучено; SMTP не є вимогою для їхнього запуску.
# За замовчуванням службова пошта пишеться в лог. Для майбутніх поштових
# функцій налаштуйте SMTP і перевірте доставлення перед їх увімкненням.
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.ВАШ-ХОСТИНГ
# Порт 465 → MAIL_SCHEME=smtps (SSL). Порт 587 → MAIL_SCHEME=smtp (STARTTLS).
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=no-reply@ВАШ-ДОМЕН
# MAIL_PASSWORD=ВАШ_ПАРОЛЬ_ПОШТИ
MAIL_FROM_ADDRESS="no-reply@ВАШ-ДОМЕН"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
