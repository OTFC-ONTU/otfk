# ── Production .env для Хостинг Україна ──
# Скопіюйте цей файл у .env на сервері та заповніть значення.

APP_NAME="Одеський технічний фаховий коледж ОНТУ"
APP_ENV=production
# Скопіюйте APP_KEY з локального .env АБО на сервері виконайте: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://ВАШ-ДОМЕН

APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_FAKER_LOCALE=uk_UA
APP_TIMEZONE=Europe/Kyiv

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── База даних (створіть у панелі хостингу та підставте значення) ──
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ВАША_БАЗА
DB_USERNAME=ВАШ_КОРИСТУВАЧ
DB_PASSWORD=ВАШ_ПАРОЛЬ

# ── Перший адміністратор (створюється при seed). Репозиторій публічний -
# обовʼязково задайте СВІЙ надійний пароль ДО запуску migrate --seed. ──
ADMIN_EMAIL=admin@ВАШ-ДОМЕН
ADMIN_PASSWORD=ЗАМІНІТЬ_НА_НАДІЙНИЙ_ПАРОЛЬ

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookie сесії лише по HTTPS (сайт працює тільки по HTTPS)
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Пошта ──
# За замовчуванням MAIL_MAILER=log: звернення/заявки НЕ йдуть на email, а лише
# зберігаються в адмінці (Звернення / Заявки). Це безпечно, але приймальна
# комісія не отримає листа. Щоб увімкнути реальні листи — впишіть SMTP хостингу,
# розкоментувавши блок нижче, і поставте MAIL_MAILER=smtp.
# Листи відправляються вже ПІСЛЯ віддачі сторінки (afterResponse), тож повільний
# SMTP не гальмує форму і черго-воркер для цього не потрібен.
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.ВАШ-ХОСТИНГ
# Порт 465 → MAIL_SCHEME=smtps (SSL). Порт 587 → MAIL_SCHEME=smtp (STARTTLS).
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=no-reply@ВАШ-ДОМЕН
# MAIL_PASSWORD=ВАШ_ПАРОЛЬ_ПОШТИ
MAIL_FROM_ADDRESS="no-reply@ВАШ-ДОМЕН"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
